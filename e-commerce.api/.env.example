# ==========================================
# E-COMMERCE API - VARIABLES D'ENVIRONNEMENT
# Copier ce fichier vers .env ou configurer
# ces variables dans l'environnement d'exécution.
# ==========================================

# --- Profil Spring ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Base de données PostgreSQL ---
POSTGRES_DB=ecommerce_db
POSTGRES_URL=jdbc:postgresql://localhost:5433/ecommerce_db
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change-me-local

# --- JWT ---
# Valeur fictive : générer un secret sécurisé pour chaque environnement.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400000

# --- Stockage des images ---
APP_STORAGE_LOCATION=./uploads/images
APP_STORAGE_MAX_FILE_SIZE=5MB
APP_STORAGE_MAX_REQUEST_SIZE=10MB